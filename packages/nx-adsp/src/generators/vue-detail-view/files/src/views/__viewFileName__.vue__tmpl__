<script setup lang="ts">
import { ref, watch } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import {
  RecordDetailShell,
  formatCurrency,
  formatDate,
<% if (hasCodedFields || hasBadgeFields) { -%>
  optionLabel,
<% } -%>
<% if (hasBadgeFields) { -%>
  badgeType,
<% } -%>
} from '<%= goaImportPath %>';
<% if (hasCodedFields || hasBadgeFields) { -%>
import type {
<% if (hasCodedFields || hasBadgeFields) { -%>
  DisplayOption,
<% } -%>
<% if (hasBadgeFields) { -%>
  BadgeType,
<% } -%>
} from '<%= goaImportPath %>';
<% } -%>
import { useApi } from '../composables/useApi';
<% if (hasCodedFields || hasBadgeFields) { -%>

// Value -> label for coded fields, so the record reads back in prose rather than
// in stored codes.
const fieldOptions: Record<string, DisplayOption[]> = {
<% fields.forEach(function (field) { -%>
<% if (field.options && field.options.length) { -%>
  '<%= field.key %>': <%- JSON.stringify(field.options) %>,
<% } -%>
<% }); -%>
};
<% } -%>
<% if (hasBadgeFields) { -%>

// Value -> badge type; unmapped values render neutral rather than being asserted
// as good or bad.
const fieldBadgeTypes: Record<string, Record<string, BadgeType>> = {
<% fields.forEach(function (field) { -%>
<% if (field.type === 'badge') { -%>
  '<%= field.key %>': <%- JSON.stringify(field.badgeMap || {}) %>,
<% } -%>
<% }); -%>
};
<% } -%>

// The fetched record's shape isn't known to this generator -- read fields
// defensively rather than declaring (and likely getting wrong) a fake interface.
const record = ref<Record<string, unknown> | null>(null);
const loading = ref(true);
const error = ref<string | null>(null);

const route = useRoute();
const router = useRouter();
const { get } = useApi();

async function load() {
  loading.value = true;
  error.value = null;
  try {
    record.value = await get('<%= resource %>', String(route.params.id));
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Failed to load.';
  } finally {
    loading.value = false;
  }
}

// Vue Router reuses this component when only the id param changes, so onMounted
// would never fire again and the previous record would stay on screen. An
// immediate watch covers first load and every later param change in one place.
watch(() => route.params.id, load, { immediate: true });

function goBack() {
  router.back();
}


</script>

<template>
  <RecordDetailShell
    heading="<%= heading %>"
    :loading="loading"
    :error="error"
    back-label="Back"
    @back="goBack"
    @retry="load"
  >
    <dl v-if="record" class="detail-fields">
<% fields.forEach(function (field) { -%>
      <dt><%= field.label %></dt>
      <dd>
<% if (field.type === 'badge') { -%>
        <goa-badge
          :type="badgeType(fieldBadgeTypes['<%= field.key %>'], record['<%= field.key %>'])"
          :content="optionLabel(fieldOptions['<%= field.key %>'], record['<%= field.key %>'])"
        />
<% } else if (field.options && field.options.length) { -%>
        {{ optionLabel(fieldOptions['<%= field.key %>'], record['<%= field.key %>']) }}
<% } else if (field.type === 'date') { -%>
        {{ formatDate(record['<%= field.key %>']) }}
<% } else if (field.type === 'currency') { -%>
        {{ formatCurrency(record['<%= field.key %>']) }}
<% } else { -%>
        {{ record['<%= field.key %>'] ?? '—' }}
<% } -%>
      </dd>
<% }); -%>
    </dl>
  </RecordDetailShell>
</template>

<style scoped>
.detail-fields {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: var(--goa-space-xs) var(--goa-space-l);
  margin: 0;
}

.detail-fields dt {
  font-weight: 600;
}
</style>
