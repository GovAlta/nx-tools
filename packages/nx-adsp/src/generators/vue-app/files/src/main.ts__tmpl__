// Design tokens must load before web-components' own CSS — every goa-*
// element styles itself through --goa-* custom properties (spacing,
// color, type) defined here; without them, headers/banners/buttons render
// with no spacing at all rather than looking unbranded but boxy.
import '@abgov/design-tokens/dist/tokens.css';
import '@abgov/web-components';
import '@abgov/web-components/index.css';
import { createApp } from 'vue';
import { createPinia } from 'pinia';
import keycloakPlugin from '@dsb-norge/vue-keycloak-js';

import App from './App.vue';
import router from './router';
import { environment } from './environments/environment';
import { useSessionStore } from './stores/session';

const app = createApp(App);
const pinia = createPinia();

app.use(pinia);
app.use(router);
app.use(keycloakPlugin, {
  config: {
    url: environment.access.url,
    realm: environment.access.realm,
    clientId: environment.access.client_id,
  },
  // checkLoginIframe: false — disables the login-status iframe that polls Keycloak
  // every 5 seconds. Two reasons: (1) unnecessary overhead — for GoA apps, refresh-
  // token expiry (onAuthRefreshError, below) is the reliable session-expiry signal,
  // and cross-tab logout detection isn't a requirement; (2) checkLoginIframe() has
  // no individual timeout in keycloak-js — if the login-status iframe stops responding
  // (partial Keycloak failure after the init probe), it hangs indefinitely. Disabling
  // it eliminates that failure mode entirely.
  // Note: keycloak-js always runs a one-time 3p-cookie probe (step1.html, 10s timeout)
  // before any iframes. When cookies are blocked the probe detects it, disables both
  // the login iframe and silentCheckSsoRedirectUri, and falls back to a redirect —
  // so blocked 3p cookies are handled gracefully regardless of this setting.
  //
  // silentCheckSsoRedirectUri — on load, keycloak-js opens a hidden iframe pointing
  // to Keycloak with prompt=none; if an existing session is found the user is auto-
  // authenticated without a visible redirect. Like checkLoginIframe(), checkSsoSilently()
  // has no timeout — set silentCheckSsoFallback to false if you need to disable it
  // when cookies are blocked rather than falling back to a redirect.
  init: {
    onLoad: 'check-sso',
    pkceMethod: 'S256',
    checkLoginIframe: false,
    silentCheckSsoRedirectUri: `${window.location.origin}/silent-check-sso.html`,
  },
  // Not onAuthLogout: keycloak-js only invokes that via the session-status
  // iframe (disabled above by checkLoginIframe: false) or in Cordova mode --
  // it would never fire here. The wrapper's own background auto-refresh
  // (autoRefreshToken, on by default) periodically calls updateToken();
  // onAuthRefreshError fires when that fails because the refresh token itself
  // has expired, which is the real, always-on "session expired" signal.
  onAuthRefreshError: () => useSessionStore(pinia).markExpired(),
});

app.mount('#app');
